# Template for running the backend and media service natively (not in
# Docker) during local development. See docs/local-development.md.
#
# Copy to .env.dev and adjust NAVIDROME_* to point at a real Navidrome
# instance if you want playable games; the placeholder below lets the app
# start and the UI load without one (games just won't have any tracks).
#
#   cp .env.dev.example .env.dev

### Local addresses ###
# Must match the port the Vite dev server actually runs on (see
# frontend/vite.config.ts / docs/local-development.md). Using a host:port
# here (not just "localhost") is required for the origin/CORS/cookie checks
# to allow the frontend dev server to talk to the backend.
APP_DOMAIN=localhost:5173
MEDIA_DOMAIN=localhost:8090

# Free host ports for the Go binaries themselves (not Docker-mapped ports —
# these processes run directly on your machine). Change if already in use.
HTTP_ADDR=:8080
MEDIA_HTTP_ADDR=:8090

### Secrets (dev-only values — never reuse these in production) ###
APP_ACCESS_CODE=devcode
ADMIN_PASSWORD=devadminpass
JWT_SECRET=dev-jwt-secret-please-use-at-least-32-characters
MEDIA_SHARED_SECRET=dev-media-secret-please-use-at-least-32-characters

### Navidrome ###
# Point this at a real Navidrome (see docs/local-development.md for a
# throwaway Docker one) to get actual playable tracks. Left unreachable, the
# app still starts and the UI works, but the library stays empty.
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USERNAME=hitsync
NAVIDROME_PASSWORD=change-me

### MusicBrainz ###
# Off by default for local dev so you don't need MUSICBRAINZ_CONTACT and
# don't rate-limit yourself against the public API while iterating. Flip to
# true (and set MUSICBRAINZ_CONTACT) to test year resolution end to end.
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_CONTACT=

### Media cache ###
# The production default (/cache) is a container path; for a native process
# use a path relative to the media/ directory (where `make dev-media` runs
# `go run` from) so it doesn't try to write to the filesystem root.
MEDIA_CACHE_DIR=.cache

### Database ###
# Matches `docker compose -f docker-compose.dev.yml up -d postgres` below.
POSTGRES_USER=hitsync
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=hitsync
DATABASE_URL=postgres://hitsync:devpassword@localhost:5432/hitsync?sslmode=disable

LOG_LEVEL=debug
