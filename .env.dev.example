# Template for running the backend natively (not in
# Docker) during local development. See docs/local-development.md.
#
#   cp .env.dev.example .env.dev
#
# Fill in NAVIDROME_* below with your real server's URL and credentials —
# local or remote, same as you would for a real deployment.

### Local addresses ###
# Must match the port the Vite dev server actually runs on (see
# frontend/vite.config.ts / docs/local-development.md). Using a host:port
# here (not just "localhost") is required for the origin/CORS/cookie checks
# to allow the frontend dev server to talk to the backend.
APP_DOMAIN=localhost:5173

# Free host port for the Go backend itself (not a Docker-mapped port — the
# process runs directly on your machine). Change if already in use.
HTTP_ADDR=:8080

### Secrets (dev-only values — never reuse these in production) ###
APP_ACCESS_CODE=devcode
ADMIN_PASSWORD=devadminpass
JWT_SECRET=dev-jwt-secret-please-use-at-least-32-characters

### Navidrome ###
# Exactly like production: point this at your actual Navidrome server (local
# or remote — any URL the backend process can reach over the network works,
# no special local networking needed for a remote one) and use real
# credentials, so the library scan pulls in your real tracks. Left
# unreachable, the app still starts and the UI works, but there are no cards
# (see docs/local-development.md if you'd rather use a throwaway local
# Navidrome instead).
NAVIDROME_URL=https://music.example.com
NAVIDROME_USERNAME=hitsync
NAVIDROME_PASSWORD=change-me

### Song cards ###
# Relative to backend/ (where `make dev-backend` runs), so native dev uses the
# same ./config/cards.json at the repository root as Docker Compose.
CARDS_FILE=../config/cards.json

### Media cache ###
# The production default (/cache) is a container path; for a native process
# use a path relative to the backend/ directory (where `make dev-backend` runs
# `go run` from) so it doesn't try to write to the filesystem root.
# FFmpeg must be on your PATH, or set FFMPEG_PATH.
MEDIA_CACHE_DIR=.cache

### Database ###
# Matches `docker compose -f docker-compose.dev.yml up -d postgres` below.
POSTGRES_USER=hitsync
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=hitsync
DATABASE_URL=postgres://hitsync:devpassword@localhost:5432/hitsync?sslmode=disable

LOG_LEVEL=debug
