# Copy this file to .env and fill in the values marked "required".
# See README.md for the full explanation of each variable.

### General ###
APP_DOMAIN=hitsync.example.com          # required
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
LOG_LEVEL=info
TZ=Europe/Berlin

### Secrets (all required) ###
APP_ACCESS_CODE=change-me
ADMIN_PASSWORD=change-me-too
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long

### Navidrome ###
NAVIDROME_URL=http://navidrome:4533     # required
NAVIDROME_USERNAME=hitsync              # required
NAVIDROME_PASSWORD=change-me            # required
NAVIDROME_CLIENT_NAME=hitsync
NAVIDROME_TIMEOUT=30s

### Audio ###
# Players download each track as an MP3 transcoded by the backend's FFmpeg.
AUDIO_BITRATE=128                       # kbit/s
MEDIA_CACHE_DIR=/cache
MEDIA_CACHE_MAX_BYTES=2147483648

### Song cards ###
# The backend writes the card collection to ./config/cards.json (mounted at
# /config) and runs as PUID:PGID so you can edit that file. Use your host
# user's ids (`id -u`, `id -g`).
PUID=1000
PGID=1000
CARDS_FILE=/config/cards.json

### Game rules and limits ###
MAX_CONCURRENT_GAMES=10
MIN_PLAYERS=2
MAX_PLAYERS=12
DEFAULT_TARGET_CARDS=10
DEFAULT_START_TOKENS=2
MAX_TOKENS=5
RULE_ENABLE_SONG_GUESS=true
TURN_PLACEMENT_TIMEOUT=90s
TURN_CHALLENGE_WINDOW=5s
REVEAL_DURATION=8s
TRACK_MIN_DURATION=45s
TRACK_MAX_DURATION=600s
PLAYER_RECONNECT_GRACE=120s
LOBBY_IDLE_TIMEOUT=30m

### Database ###
POSTGRES_USER=hitsync
POSTGRES_PASSWORD=change-me-db-password # required
POSTGRES_DB=hitsync
# DATABASE_URL=postgres://hitsync:change-me-db-password@postgres:5432/hitsync?sslmode=disable
